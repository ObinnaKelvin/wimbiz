# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Configuration
# Provide your MongoDB Atlas or self-hosted connection URI to persist anonymous app records
MONGODB_URI=""
MONGODB_DB_NAME="iwosan_herhealth"

# Administrator Staff Portal Credentials
ADMIN_EMAIL="admin@iwosan.com"
ADMIN_PASSWORD="IwosanAdmin2026!"
ADMIN_SESSION_SECRET="iwosan-herhealth-wimbiz-secure-admin-session-2026"
PORT=3000

# Iwosan Concierge Booking Notification Email Configuration
# Configured receiving email where screening & callback requests are delivered in tabular format
CONCIERGE_RECEIVING_EMAIL="okereobinna11@gmail.com"
CONCIERGE_CC_EMAILS="wellness@iwosanlagoon.life"

# Optional SMTP Settings (If not set, emails are safely logged and simulated with high fidelity)
# For Microsoft Office 365 / Outlook, use smtp.office365.com on port 587 with STARTTLS (SMTP_SECURE="false")
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="hello@iwosanwellness.com"
SMTP_PASS=""
SMTP_FROM="hello@iwosanwellness.com"
