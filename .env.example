# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Configuration
# Provide your MongoDB Atlas or self-hosted connection URI to persist anonymous app records
MONGODB_URI=""
MONGODB_DB_NAME="iwosan_herhealth"

# Administrator Staff Portal Credentials
ADMIN_EMAIL="admin@iwosan.com"
ADMIN_PASSWORD="IwosanAdmin2026!"
ADMIN_SESSION_SECRET="iwosan-herhealth-wimbiz-secure-admin-session-2026"
PORT=3000

# Iwosan Concierge Booking Notification Email Configuration
# Configured receiving email where screening & callback requests are delivered in tabular format
CONCIERGE_RECEIVING_EMAIL="hello@iwosanwellness.com"
CONCIERGE_CC_EMAILS="okereobinna11@gmail.com"

# Resend Email Service Configuration (Recommended for Cloud / Railway / Render Hosting - HTTPS Port 443)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="Iwosan Concierge <hello@iwosanwellness.com>"

# Optional SMTP / Webmail Fallback Settings
SMTP_HOST="server343-5.web-hosting.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hello@iwosanwellness.com"
SMTP_PASS=""
SMTP_FROM="Iwosan Concierge <hello@iwosanwellness.com>"
